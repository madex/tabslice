# --- Admin-Zugang ---------------------------------------------------------
# Entweder ein Klartext-Passwort (einfach) ...
ADMIN_PASSWORD="change-me-to-a-long-random-password"

# ... oder ein scrypt-Hash (empfohlen fuer Produktion):
#   npm run hash-password -- "dein-passwort"
# und das Ergebnis hier eintragen. Wenn gesetzt, hat es Vorrang vor
# ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH="scrypt$<salt-hex>$<hash-hex>"

# --- Server ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# Hinter nginx/Caddy auf 1 setzen, damit Rate-Limits die echte Client-IP
# sehen und Secure-Cookies korrekt funktionieren.
TRUST_PROXY=0

# Secure-Cookies: in Produktion standardmaessig an. Nur bei reinem HTTP
# (ohne TLS) auf 0 setzen.
# COOKIE_SECURE=1

# Wer die Seite per <iframe> einbetten darf. Standard: alle.
# Fuer mehr Sicherheit z. B.:
# EMBED_FRAME_ANCESTORS="'self' https://forum.example.com"
EMBED_FRAME_ANCESTORS="*"
